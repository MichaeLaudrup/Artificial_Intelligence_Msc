   "source": [
    "def normalize_prediction_keys(pred: pd.DataFrame, students_meta: pd.DataFrame) -> pd.DataFrame:\n",
    "    pred = pred.copy()\n",
    "\n",
    "    if 'unique_id' in pred.columns:\n",
    "        pred['unique_id'] = pred['unique_id'].astype(str)\n",
    "        if 'id_student' not in pred.columns:\n",
    "            pred['id_student'] = pred['unique_id'].str.split('_').str[0]\n",
    "        else:\n",
    "            pred['id_student'] = pred['id_student'].astype(str)\n",
    "        pred['prediction_key_source'] = 'unique_id_column'\n",
    "        return pred\n",
    "\n",
    "    if 'id_student' not in pred.columns:\n",
    "        raise ValueError('Las predicciones no contienen ni unique_id ni id_student.')\n",
    "\n",
    "    pred['id_student'] = pred['id_student'].astype(str)\n",
    "    looks_like_unique_id = pred['id_student'].str.count('_').ge(2).mean() > 0.9\n",
    "\n",
    "    if looks_like_unique_id:\n",
    "        pred['unique_id'] = pred['id_student']\n",
    "        pred['id_student'] = pred['id_student'].str.split('_').str[0]\n",
    "        pred['prediction_key_source'] = 'id_student_contains_unique_id'\n",
    "    else:\n",
    "        pred['prediction_key_source'] = 'plain_id_student'\n",
    "\n",
    "    known_unique_ids = set(students_meta['unique_id'].astype(str))\n",
    "    if 'unique_id' in pred.columns:\n",
    "        pred['unique_id_in_students'] = pred['unique_id'].isin(known_unique_ids)\n",
    "\n",
    "    return pred\n",
    "\n",
    "\n",
    "seg = pd.read_csv(seg_path)\n",
    "pred = pd.read_csv(pred_path)\n",
    "\n",
    "if 'unique_id' not in seg.columns:\n",
    "    if 'Unnamed: 0' in seg.columns:\n",
    "        seg = seg.rename(columns={'Unnamed: 0': 'unique_id'})\n",
    "    else:\n",
    "        raise ValueError('La segmentación no contiene unique_id y no puedo reconciliarla de forma segura.')\n",
    "\n",
    "seg['unique_id'] = seg['unique_id'].astype(str)\n",
    "pred = normalize_prediction_keys(pred, students_meta)\n",
    "\n",
    "id_cardinality = students_meta.groupby('id_student')['unique_id'].nunique().rename('unique_id_count').reset_index()\n",
    "pred = pred.merge(id_cardinality, on='id_student', how='left')\n",
    "\n",
    "student_lookup = students_meta[[\n",
    "    'id_student', 'unique_id', 'code_module', 'code_presentation', 'final_result',\n",
    "    'gender', 'age_band', 'highest_education', 'studied_credits'\n",
    "]].drop_duplicates()\n",
    "\n",
    "if pred['prediction_key_source'].eq('plain_id_student').all():\n",
    "    pred_enriched = pred.merge(student_lookup, on='id_student', how='left')\n",
    "else:\n",
    "    pred_enriched = pred.merge(\n",
    "        student_lookup,\n",
    "        on=['id_student', 'unique_id'],\n",
    "        how='left'\n",
    "    )\n",
    "\n",
    "pred_enriched['join_status'] = np.where(\n",
    "    pred_enriched['unique_id'].notna(),\n",
    "    'ok',\n",
    "    'ambiguous_or_missing'\n",
    ")\n",
    "\n",
    "decision_df = pred_enriched.merge(seg, on='unique_id', how='left', suffixes=('_pred', '_cluster'))\n",
    "\n",
    "print({\n",
    "    'pred_rows': len(pred),\n",
    "    'seg_rows': len(seg),\n",
    "    'merged_rows': len(decision_df),\n",
    "    'prediction_key_source': pred['prediction_key_source'].iloc[0] if len(pred) else None,\n",
    "    'safe_join_ratio': float((decision_df['join_status'] == 'ok').mean()) if len(decision_df) else np.nan,\n",
    "    'cluster_match_ratio': float(decision_df['cluster_name'].notna().mean()) if len(decision_df) else np.nan,\n",
    "})\n",
    "decision_df.head()"
   ]
  },
