    "\n",
    "        show_cols = [\"k\", \"BIC\", \"AIC\", \"ΔBIC (k-1→k)\", \"ΔAIC (k-1→k)\", \"%ΔBIC\", \"%ΔAIC\"]\n",
    "\n",
    "        disp = d[show_cols].copy()\n",
    "\n",
    "        for c in [\"BIC\", \"AIC\", \"ΔBIC (k-1→k)\", \"ΔAIC (k-1→k)\", \"%ΔBIC\", \"%ΔAIC\"]:\n",
    "\n",
    "            disp[c] = disp[c].map(lambda v: np.nan if pd.isna(v) else round(float(v), 4))\n",
    "\n",
    "\n",
    "\n",
    "        display(Markdown(f\"###
