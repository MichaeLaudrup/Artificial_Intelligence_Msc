    "    'ternary_classification',\n",
    "    'quaternary_classification',\n",
    "]\n",
    "\n",
    "print({\n",
    "    'root_exists': ROOT.exists(),\n",
    "    'processed_exists': PROCESSED.exists(),\n",
    "    'segmented_exists': SEGMENTED.exists(),\n",
