    "\n",
    "        fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(14, 4), constrained_layout=True)\n",
    "\n",
    "        fig.patch.set_facecolor(BIC_DARK_BG)\n",
    "\n",
    "\n",
    "\n",
    "        ax1.plot(d[\"k\"], d[\"BIC\"], marker=\"o\", linewidth=2, color=BIC_BIC_COLOR, label=\"BIC\")\n",
    "\n",
    "        ax1.plot(d[\"k\"], d[\"AIC\"], marker=\"s\", linewidth=2, color=BIC_AIC_COLOR, label=\"AIC\")\n",
    "\n",
    "        ax1.set_title(f\"{emb_name} | BIC/AIC (menor=mejor)\")\n",
    "\n",
    "        ax1.set_xlabel(\"k\")\n",
    "\n",
    "        ax1.set_ylabel(\"Score\")\n",
    "\n",
    "        _style_biaic_axis_dark(ax1)\n",
    "\n",
    "        _style_biaic_legend_dark(ax1)\n",
    "\n",
    "\n",
    "\n",
    "        ax2.plot(d[\"k\"], d[\"ΔBIC (k-1→k)\"], marker=\"o\", linewidth=2, color=BIC_DELTA_BIC_COLOR, label=\"ΔBIC\")\n",
    "\n",
    "        ax2.plot(d[\"k\"], d[\"ΔAIC (k-1→k)\"], marker=\"s\", linewidth=2, color=BIC_DELTA_AIC_COLOR, label=\"ΔAIC\")\n",
    "\n",
    "        ax2.axhline(0.0, color=\"#B0BEC5\", linestyle=\"--\", alpha=0.6)\n",
    "\n",
    "        ax2.set_title(f\"{emb_name} | Mejora marginal (positivo=mejora)\")\n",
    "\n",
    "        ax2.set_xlabel(\"k\")\n",
    "\n",
    "        ax2.set_ylabel(\"Ganancia\")\n",
    "\n",
    "        _style_biaic_axis_dark(ax2)\n",
    "\n",
    "        _style_biaic_legend_dark(ax2)\n",
    "\n",
    "\n",
    "\n",
    "        plt.show()\n",
    "\n",
    "\n",
    "\n",
    "    
    "\n",
    "    rec_rows = []\n",
    "\n",
    "    for emb_name in df_biaic[\"Embedding\"].unique():\n",
    "\n",
    "        d = df_biaic[df_biaic[\"Embedding\"] == emb_name].sort_values(\"k\").copy()\n",
    "\n",
    "\n",
    "\n",
    "        
    "\n",
    "        cond = (d[\"%ΔBIC\"] < 1.0) & (d[\"%ΔAIC\"] < 1.0)\n",
    "\n",
    "        if cond.any():\n",
    "\n",
    "            k_star = int(d.loc[cond, \"k\"].iloc[0])\n",
    "\n",
    "            rule = \"primer k con mejora marginal <1%\"\n",
    "\n",
    "        else:\n",
    "\n",
    "            k_star = int(d.loc[d[\"BIC\"].idxmin(), \"k\"])\n",
    "\n",
    "            rule = \"mínimo BIC\"\n",
    "\n",
    "        rec_rows.append({\"Embedding\": emb_name, \"k_sugerido\": k_star, \"criterio\": rule})\n",
    "\n",
    "\n",
    "\n",
    "    display(Markdown(\"##
    "\n",
    "    display(pd.DataFrame(rec_rows))\n"
   ]
