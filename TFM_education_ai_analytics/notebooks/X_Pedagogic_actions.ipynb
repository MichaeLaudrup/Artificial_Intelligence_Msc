   "source": [
    "from pathlib import Path\n",
    "import re\n",
    "\n",
    "import pandas as pd\n",
    "\n",
    "ROOT = Path(\"/workspace/TFM_education_ai_analytics\")\n",
    "SEGMENTED = ROOT / \"data\" / \"5_students_segmented\"\n",
    "PREDS = ROOT / \"data\" / \"7_model_predictions\"\n",
    "\n",
    "PRED_SCOPE = \"binary_classification_paper\"\n",
    "SPLITS = [\"validation\", \"test\"]\n",
    "SELECTED_WEEK = 5\n",
    "\n",
    "\n",
    "def discover_segmented_files(split: str) -> pd.DataFrame:\n",
    "    root = SEGMENTED / split\n",
    "    rows = []\n",
    "\n",
    "    if not root.exists():\n",
    "        return pd.DataFrame(columns=[\"split\", \"week\", \"path\"] )\n",
    "\n",
    "    for path in sorted(root.glob(\"students_segmented_uptoW*.csv\")):\n",
    "        match = re.search(r\"uptoW(\\d+)\", path.name)\n",
    "        if match:\n",
    "            rows.append(\n",
    "                {\n",
    "                    \"split\": split,\n",
    "                    \"week\": int(match.group(1)),\n",
    "                    \"path\": path,\n",
    "                }\n",
    "            )\n",
    "\n",
    "    return pd.DataFrame(rows).sort_values(\"week\").reset_index(drop=True)\n",
    "\n",
    "\n",
    "def discover_prediction_files(split: str, scope: str = PRED_SCOPE) -> pd.DataFrame:\n",
    "    candidate_roots = [\n",
    "        PREDS / scope / split,\n",
    "        PREDS / split,\n",
    "    ]\n",
    "    rows = []\n",
    "\n",
    "    for root in candidate_roots:\n",
    "        if not root.exists():\n",
    "            continue\n",
    "\n",
    "        for path in sorted(root.glob(\"transformer_preds_uptW*.csv\")):\n",
    "            match = re.search(r\"uptW(\\d+)\", path.name)\n",
    "            if match:\n",
    "                rows.append(\n",
    "                    {\n",
    "                        \"scope\": scope,\n",
    "                        \"split\": split,\n",
    "                        \"week\": int(match.group(1)),\n",
    "                        \"path\": path,\n",
    "                    }\n",
    "                )\n",
    "\n",
    "    if not rows:\n",
    "        return pd.DataFrame(columns=[\"scope\", \"split\", \"week\", \"path\"] )\n",
    "\n",
    "    return (\n",
    "        pd.DataFrame(rows)\n",
    "        .drop_duplicates(subset=[\"split\", \"week\", \"path\"])\n",
    "        .sort_values(\"week\")\n",
    "        .reset_index(drop=True)\n",
    "    )\n",
    "\n",
    "\n",
    "def normalize_prediction_keys(pred: pd.DataFrame) -> pd.DataFrame:\n",
    "    pred = pred.copy()\n",
    "\n",
    "    if \"unique_id\" in pred.columns:\n",
    "        pred[\"unique_id\"] = pred[\"unique_id\"].astype(str)\n",
    "        if \"id_student\" not in pred.columns:\n",
    "            pred[\"id_student\"] = pred[\"unique_id\"].str.split(\"_\").str[0]\n",
    "        else:\n",
    "            pred[\"id_student\"] = pred[\"id_student\"].astype(str)\n",
    "        return pred\n",
    "\n",
    "    if \"id_student\" not in pred.columns:\n",
    "        raise ValueError(\"El archivo de predicción no contiene ni unique_id ni id_student.\")\n",
    "\n",
    "    pred[\"id_student\"] = pred[\"id_student\"].astype(str)\n",
    "\n",
    "    if pred[\"id_student\"].str.count(\"_\").ge(2).mean() > 0.9:\n",
    "        pred[\"unique_id\"] = pred[\"id_student\"]\n",
    "        pred[\"id_student\"] = pred[\"id_student\"].str.split(\"_\").str[0]\n",
    "\n",
    "    return pred\n",
    "\n",
    "\n",
    "artifacts = {}\n",
    "summary_rows = []\n",
    "\n",
    "for split in SPLITS:\n",
    "    seg_files = discover_segmented_files(split)\n",
    "    pred_files = discover_prediction_files(split, PRED_SCOPE)\n",
    "\n",
    "    common_weeks = sorted(set(seg_files[\"week\"]).intersection(pred_files[\"week\"]))\n",
    "\n",
    "    if not common_weeks:\n",
    "        artifacts[split] = {\n",
    "            \"week\": None,\n",
    "            \"segmented\": None,\n",
    "            \"transformer\": None,\n",
    "            \"seg_path\": None,\n",
    "            \"pred_path\": None,\n",
    "        }\n",
    "        summary_rows.append(\n",
    "            {\n",
    "                \"split\": split,\n",
    "                \"week\": None,\n",
    "                \"seg_rows\": 0,\n",
    "                \"pred_rows\": 0,\n",
    "                \"seg_path\": None,\n",
    "                \"pred_path\": None,\n",
    "            }\n",
    "        )\n",
    "        continue\n",
    "\n",
    "    week = SELECTED_WEEK\n",
    "    if week not in common_weeks:\n",
    "        raise ValueError(f\"{split}: la semana {week} no está disponible. Semanas comunes: {common_weeks}\")\n",
    "\n",
    "    seg_path = seg_files.loc[seg_files[\"week\"] == week, \"path\"].iloc[-1]\n",
    "    pred_path = pred_files.loc[pred_files[\"week\"] == week, \"path\"].iloc[-1]\n",
    "\n",
    "    segmented_df = pd.read_csv(seg_path)\n",
    "    transformer_df = normalize_prediction_keys(pd.read_csv(pred_path))\n",
    "\n",
    "    artifacts[split] = {\n",
    "        \"week\": week,\n",
    "        \"segmented\": segmented_df,\n",
    "        \"transformer\": transformer_df,\n",
    "        \"seg_path\": seg_path,\n",
    "        \"pred_path\": pred_path,\n",
    "    }\n",
    "\n",
    "    summary_rows.append(\n",
    "        {\n",
    "            \"split\": split,\n",
    "            \"week\": week,\n",
    "            \"seg_rows\": len(segmented_df),\n",
    "            \"pred_rows\": len(transformer_df),\n",
    "            \"seg_path\": str(seg_path),\n",
    "            \"pred_path\": str(pred_path),\n",
    "        }\n",
    "    )\n",
    "\n",
    "artifacts_summary = pd.DataFrame(summary_rows)\n",
    "display(artifacts_summary)\n",
    "\n",
    "seg_validation = artifacts[\"validation\"][\"segmented\"]\n",
    "pred_validation = artifacts[\"validation\"][\"transformer\"]\n",
    "seg_test = artifacts[\"test\"][\"segmented\"]\n",
    "pred_test = artifacts[\"test\"][\"transformer\"]\n",
    "\n",
    "print(\"Objetos disponibles:\")\n",
    "print(\" - seg_validation\")\n",
    "print(\" - pred_validation\")\n",
    "print(\" - seg_test\")\n",
    "print(\" - pred_test\")"
   ]
  },
