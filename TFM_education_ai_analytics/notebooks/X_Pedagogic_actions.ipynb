   "source": [
    "import numpy as np\n",
    "import pandas as pd\n",
    "from sklearn.metrics import accuracy_score, balanced_accuracy_score, f1_score, confusion_matrix\n",
    "\n",
    "rule_df = simple_predictions_table.copy()\n",
    "\n",
    "required_cols = [\n",
    "    \"split\",\n",
    "    \"student_unique_id\",\n",
    "    \"cluster_prediction_id\",\n",
    "    \"cluster_prediction_label\",\n",
    "    \"transformer_prediction_label\",\n",
    "    \"transformer_probability\",\n",
    "    \"real_label\",\n",
    "]\n",
    "missing = [col for col in required_cols if col not in rule_df.columns]\n",
    "if missing:\n",
    "    raise ValueError(f\"Faltan columnas necesarias: {missing}\")\n",
    "\n",
    "rule_df = rule_df.dropna(subset=required_cols).copy()\n",
    "\n",
    "labels = sorted(rule_df[\"real_label\"].dropna().unique())\n",
    "if len(labels) != 2:\n",
    "    raise ValueError(f\"Este análisis está pensado para 2 clases y aquí hay {len(labels)}: {labels}\")\n",
    "\n",
    "positive_label = \"Withdrawn\" if \"Withdrawn\" in labels else labels[-1]\n",
    "negative_label = [label for label in labels if label != positive_label][0]\n",
    "\n",
    "cluster_rule_map = {\n",
    "    0: positive_label,\n",
    "    1: positive_label,\n",
    "    2: \"unknown\",\n",
    "    3: \"unknown\",\n",
    "    4: negative_label,\n",
    "}\n",
    "\n",
    "rule_df[\"cluster_rule_label\"] = rule_df[\"cluster_prediction_id\"].map(cluster_rule_map).fillna(\"unknown\")\n",
    "rule_df[\"transformer_uncertainty\"] = (rule_df[\"transformer_probability\"] - 0.5).abs()\n",
    "\n",
    "val_rule = rule_df[rule_df[\"split\"] == \"validation\"].copy()\n",
    "test_rule = rule_df[rule_df[\"split\"] == \"test\"].copy()\n",
    "\n",
    "def compute_metrics(df: pd.DataFrame, pred_col: str, model_name: str) -> dict:\n",
    "    return {\n",
    "        \"model\": model_name,\n",
    "        \"accuracy\": accuracy_score(df[\"real_label\"], df[pred_col]),\n",
    "        \"balanced_accuracy\": balanced_accuracy_score(df[\"real_label\"], df[pred_col]),\n",
    "        \"f1_macro\": f1_score(df[\"real_label\"], df[pred_col], average=\"macro\"),\n",
    "    }\n",
    "\n",
    "
    "cluster_known_test = test_rule[test_rule[\"cluster_rule_label\"] != \"unknown\"].copy()\n",
    "if cluster_known_test.empty:\n",
    "    raise ValueError(\"No hay casos con label de cluster conocido en test.\")\n",
    "\n",
    "pure_cluster_metrics = compute_metrics(\n",
    "    cluster_known_test,\n",
    "    \"cluster_rule_label\",\n",
    "    \"cluster_rule_only_known_cases\",\n",
    ")\n",
    "\n",
    "baseline_known_metrics = compute_metrics(\n",
    "    cluster_known_test.assign(baseline_pred=test_rule.loc[cluster_known_test.index, \"transformer_prediction_label\"]),\n",
    "    \"baseline_pred\",\n",
    "    \"transformer_baseline_on_known_cases\",\n",
    ")\n",
    "\n",
    "print(\"Cobertura de la regla de cluster en test:\")\n",
    "display(\n",
    "    pd.DataFrame(\n",
    "        [\n",
    "            {\n",
    "                \"n_test_total\": len(test_rule),\n",
    "                \"n_known_cluster_rule\": len(cluster_known_test),\n",
    "                \"known_ratio\": len(cluster_known_test) / len(test_rule),\n",
    "            }\n",
    "        ]\n",
    "    ).round(4)\n",
    ")\n",
    "\n",
    "print(\"Comparación en casos con cluster conocido:\")\n",
    "display(pd.DataFrame([baseline_known_metrics, pure_cluster_metrics]).round(4))\n",
    "\n",
    "
    "def apply_cluster_frontier_rule(df: pd.DataFrame, threshold: float) -> pd.DataFrame:\n",
    "    out = df.copy()\n",
    "    out[\"use_cluster_rule\"] = (\n",
    "        (out[\"cluster_rule_label\"] != \"unknown\")\n",
    "        & (out[\"transformer_uncertainty\"] <= threshold)\n",
    "    )\n",
    "    out[\"hybrid_pred_label\"] = np.where(\n",
    "        out[\"use_cluster_rule\"],\n",
    "        out[\"cluster_rule_label\"],\n",
    "        out[\"transformer_prediction_label\"],\n",
    "    )\n",
    "    return out\n",
    "\n",
    "threshold_grid = np.round(np.arange(0.00, 0.31, 0.01), 2)\n",
    "\n",
    "search_rows = []\n",
    "for threshold in threshold_grid:\n",
    "    val_hybrid = apply_cluster_frontier_rule(val_rule, threshold)\n",
    "    metrics = compute_metrics(val_hybrid, \"hybrid_pred_label\", \"cluster_frontier_rule_validation\")\n",
    "    search_rows.append(\n",
    "        {\n",
    "            \"uncertainty_threshold\": threshold,\n",
    "            \"accuracy\": metrics[\"accuracy\"],\n",
    "            \"balanced_accuracy\": metrics[\"balanced_accuracy\"],\n",
    "            \"f1_macro\": metrics[\"f1_macro\"],\n",
    "            \"cluster_rule_usage_ratio\": val_hybrid[\"use_cluster_rule\"].mean(),\n",
    "        }\n",
    "    )\n",
    "\n",
    "search_df = pd.DataFrame(search_rows).sort_values(\n",
    "    [\"f1_macro\", \"balanced_accuracy\", \"accuracy\"],\n",
    "    ascending=False,\n",
    ").reset_index(drop=True)\n",
    "\n",
    "best_threshold = float(search_df.iloc[0][\"uncertainty_threshold\"])\n",
    "test_hybrid = apply_cluster_frontier_rule(test_rule, best_threshold)\n",
    "\n",
    "baseline_metrics = compute_metrics(\n",
    "    test_hybrid.assign(baseline_pred_label=test_hybrid[\"transformer_prediction_label\"]),\n",
    "    \"baseline_pred_label\",\n",
    "    \"transformer_baseline_test\",\n",
    ")\n",
    "\n",
    "hybrid_metrics = compute_metrics(\n",
    "    test_hybrid,\n",
    "    \"hybrid_pred_label\",\n",
    "    \"cluster_frontier_rule_test\",\n",
    ")\n",
    "\n",
    "comparison_metrics = pd.DataFrame([baseline_metrics, hybrid_metrics])\n",
    "comparison_metrics[\"accuracy_delta_vs_baseline\"] = comparison_metrics[\"accuracy\"] - baseline_metrics[\"accuracy\"]\n",
    "comparison_metrics[\"balanced_accuracy_delta_vs_baseline\"] = (\n",
    "    comparison_metrics[\"balanced_accuracy\"] - baseline_metrics[\"balanced_accuracy\"]\n",
    ")\n",
    "comparison_metrics[\"f1_macro_delta_vs_baseline\"] = (\n",
    "    comparison_metrics[\"f1_macro\"] - baseline_metrics[\"f1_macro\"]\n",
    ")\n",
    "\n",
    "print(\"Top thresholds en validation:\")\n",
    "display(search_df.head(15).round(4))\n",
    "\n",
    "print(f\"Mejor threshold encontrado: {best_threshold:.2f}\")\n",
    "display(comparison_metrics.round(4))\n",
    "\n",
    "labels_cm = sorted(test_hybrid[\"real_label\"].unique())\n",
    "\n",
    "baseline_cm = pd.DataFrame(\n",
    "    confusion_matrix(test_hybrid[\"real_label\"], test_hybrid[\"transformer_prediction_label\"], labels=labels_cm),\n",
    "    index=[f\"real_{label}\" for label in labels_cm],\n",
    "    columns=[f\"pred_{label}\" for label in labels_cm],\n",
    ")\n",
    "\n",
    "hybrid_cm = pd.DataFrame(\n",
    "    confusion_matrix(test_hybrid[\"real_label\"], test_hybrid[\"hybrid_pred_label\"], labels=labels_cm),\n",
    "    index=[f\"real_{label}\" for label in labels_cm],\n",
    "    columns=[f\"pred_{label}\" for label in labels_cm],\n",
    ")\n",
    "\n",
    "print(\"Confusion matrix: transformer baseline\")\n",
    "display(baseline_cm)\n",
    "\n",
    "print(\"Confusion matrix: regla cluster + frontera\")\n",
    "display(hybrid_cm)\n",
    "\n",
    "interesting_cases = test_hybrid.loc[\n",
    "    test_hybrid[\"use_cluster_rule\"],\n",
    "    [\n",
    "        \"student_unique_id\",\n",
    "        \"cluster_prediction_id\",\n",
    "        \"cluster_prediction_label\",\n",
    "        \"cluster_rule_label\",\n",
    "        \"transformer_prediction_label\",\n",
    "        \"transformer_probability\",\n",
    "        \"transformer_uncertainty\",\n",
    "        \"hybrid_pred_label\",\n",
    "        \"real_label\",\n",
    "    ],\n",
    "].sort_values(\"transformer_uncertainty\").reset_index(drop=True)\n",
    "\n",
    "print(\"Casos donde se usó la regla del cluster:\")\n",
    "display(interesting_cases.head(50))"
   ]
  }
 ],
