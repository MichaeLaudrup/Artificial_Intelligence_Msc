    "def discover_segmented_files(split: str = DEFAULT_SPLIT) -> pd.DataFrame:\n",
    "    root = SEGMENTED / split\n",
    "    if not root.exists():\n",
    "        return pd.DataFrame(columns=['split', 'week', 'path'])\n",
    "\n",
    "    rows = []\n",
    "    for path in sorted(root.glob('students_segmented_uptoW*.csv')):\n",
    "        m = re.search(r'uptoW(\\d+)', path.name)\n",
    "        if not m:\n",
    "            continue\n",
    "        rows.append({'split': split, 'week': int(m.group(1)), 'path': path})\n",
    "    return pd.DataFrame(rows).sort_values('week') if rows else pd.DataFrame(columns=['split', 'week', 'path'])\n",
    "\n",
    "\n",
    "def _prediction_roots(scope: str | None, split: str) -> list[tuple[str, Path]]:\n",
    "    if not PREDS.exists():\n",
    "        return []\n",
    "\n",
    "    candidates: list[tuple[str, Path]] = []\n",
    "    seen: set[tuple[str, Path]] = set()\n",
    "\n",
    "    def add_candidate(scope_name: str, root: Path) -> None:\n",
    "        key = (scope_name, root)\n",
    "        if root.exists() and key not in seen:\n",
    "            candidates.append(key)\n",
    "            seen.add(key)\n",
    "\n",
    "    if scope:\n",
    "        add_candidate(scope, PREDS / scope / split)\n",
    "        add_candidate(scope, PREDS / split)\n",
    "        return candidates\n",
    "\n",
    "    add_candidate('default', PREDS / split)\n",
    "\n",
    "    scope_dirs = sorted([path for path in PREDS.iterdir() if path.is_dir()], key=lambda path: path.name)\n",
    "    preferred_order = {name: idx for idx, name in enumerate(PREFERRED_PRED_SCOPES)}\n",
    "    scope_dirs = sorted(scope_dirs, key=lambda path: (preferred_order.get(path.name, len(preferred_order)), path.name))\n",
    "\n",
    "    for scope_dir in scope_dirs:\n",
    "        add_candidate(scope_dir.name, scope_dir / split)\n",
    "\n",
    "    return candidates\n",
    "\n",
    "\n",
    "def discover_prediction_files(scope: str | None = DEFAULT_PRED_SCOPE, split: str = DEFAULT_SPLIT) -> pd.DataFrame:\n",
    "    rows = []\n",
    "    for scope_name, root in _prediction_roots(scope, split):\n",
    "        for path in sorted(root.glob('transformer_preds_uptW*.csv')):\n",
    "            m = re.search(r'uptW(\\d+)', path.name)\n",
    "            if not m:\n",
    "                continue\n",
    "            rows.append({'scope': scope_name, 'split': split, 'week': int(m.group(1)), 'path': path})\n",
    "\n",
    "    if not rows:\n",
    "        return pd.DataFrame(columns=['scope', 'split', 'week', 'path'])\n",
    "\n",
    "    return pd.DataFrame(rows).sort_values('week', kind='stable').reset_index(drop=True)\n",
    "\n",
    "\n",
    "seg_files = discover_segmented_files()\n",
    "pred_files = discover_prediction_files()\n",
    "\n",
    "display(seg_files.tail(10))\n",
    "display(pred_files.tail(10))"
   ]
