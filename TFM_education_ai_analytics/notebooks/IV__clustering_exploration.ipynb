    "
    "
    "
    "
    "
    "import numpy as np\n",
    "import pandas as pd\n",
    "from IPython.display import display, Markdown\n",
    "from sklearn.mixture import GaussianMixture\n",
    "from sklearn.metrics import calinski_harabasz_score, davies_bouldin_score\n",
    "from sklearn.model_selection import ParameterGrid\n",
    "from sklearn.preprocessing import StandardScaler, RobustScaler, PowerTransformer\n",
    "from tqdm.auto import tqdm\n",
    "\n",
    "last_w = WS_TO_PLOT[-1]\n",
    "grid_results = []\n",
    "failed_configs = []\n",
    "\n",
    "display(Markdown(f\"##
    "\n",
    "
    "SCALERS = {\n",
    "    \"StandardScaler\": StandardScaler(),\n",
    "    \"RobustScaler\": RobustScaler(),\n",
    "    \"PowerTransformer\": PowerTransformer(method=\"yeo-johnson\", standardize=True),\n",
    "}\n",
    "\n",
    "
    "
    "param_grid = {\n",
    "    \"covariance_type\": [\"full\", \"tied\", \"diag\", \"spherical\"],\n",
    "    \"init_params\": [\"kmeans\", \"random\"],\n",
    "    \"reg_covar\": [1e-6, 1e-4, 1e-2],\n",
    "    \"max_iter\": [100, 300],\n",
    "    \"tol\": [1e-3, 1e-5],\n",
    "    \"scaler\": list(SCALERS.keys()),\n",
    "}\n",
    "\n",
    "grid = list(ParameterGrid(param_grid))\n",
    "total = len(grid)\n",
    "print(f\"Total de combinaciones por embedding: {total}\")\n",
    "print(f\"Total global (x2 embeddings): {total * len(EMB_TYPES)}\")\n",
    "\n",
    "for emb_t in EMB_TYPES:\n",
    "    path = ROOT / SPLIT / f\"upto_w{last_w:02d}\" / f\"{emb_t}_latent.csv\"\n",
    "    if not path.exists():\n",
    "        print(f\"⚠️ No existe embedding para {emb_t.upper()}: {path}\")\n",
    "        continue\n",
    "\n",
    "    df_l = safe_read_csv(path)\n",
    "    if df_l.empty:\n",
    "        print(f\"⚠️ Embedding vacío para {emb_t.upper()}\")\n",
    "        continue\n",
    "\n",
    "    idx_aligned = df_target.index.intersection(df_l.index)\n",
    "    if len(idx_aligned) == 0:\n",
    "        print(f\"⚠️ Sin intersección de índices para {emb_t.upper()}\")\n",
    "        continue\n",
    "\n",
    "    X_raw = df_l.loc[idx_aligned].values.astype(np.float32)\n",
    "\n",
    "    pbar = tqdm(grid, desc=f\"🔎 {emb_t.upper()}\", total=total, leave=True)\n",
    "\n",
    "    for params in pbar:\n",
    "        pbar.set_postfix({\n",
    "            \"cov\": params[\"covariance_type\"],\n",
    "            \"init\": params[\"init_params\"],\n",
    "            \"scaler\": params[\"scaler\"][:8],\n",
    "        })\n",
    "\n",
    "        try:\n",
    "            scaler = SCALERS[params[\"scaler\"]]\n",
    "            X_std = scaler.fit_transform(X_raw)\n",
    "\n",
    "            gmm = GaussianMixture(\n",
    "                n_components=5,\n",
    "                covariance_type=params[\"covariance_type\"],\n",
    "                init_params=params[\"init_params\"],\n",
    "                reg_covar=params[\"reg_covar\"],\n",
    "                max_iter=params[\"max_iter\"],\n",
    "                tol=params[\"tol\"],\n",
    "                n_init=5,\n",
    "                random_state=SEED,\n",
    "            )\n",
    "            gmm.fit(X_std)\n",
    "            cl_raw = gmm.predict(X_std)\n",
    "\n",
    "            n_clusters_found = len(np.unique(cl_raw))\n",
    "            if n_clusters_found > 1:\n",
    "                sil = safe_silhouette(X_std, cl_raw, SEED, sample_max=10000)\n",
    "                ch = calinski_harabasz_score(X_std, cl_raw)\n",
    "                db = davies_bouldin_score(X_std, cl_raw)\n",
    "                bic = float(gmm.bic(X_std))\n",
    "                aic = float(gmm.aic(X_std))\n",
    "                ll = float(gmm.score(X_std))\n",
    "            else:\n",
    "                sil, ch, db, bic, aic, ll = [np.nan] * 6\n",
    "\n",
    "            grid_results.append({\n",
    "                \"Embedding\": emb_t.upper(),\n",
    "                \"Scaler\": params[\"scaler\"],\n",
    "                \"Covarianza\": params[\"covariance_type\"],\n",
    "                \"Init\": params[\"init_params\"],\n",
    "                \"reg_covar\": params[\"reg_covar\"],\n",
    "                \"max_iter\": params[\"max_iter\"],\n",
    "                \"tol\": params[\"tol\"],\n",
    "                \"Clusters encontrados\": n_clusters_found,\n",
    "                \"Silueta\": sil,\n",
    "                \"CH\": ch,\n",
    "                \"DB\": db,\n",
    "                \"BIC\": bic,\n",
    "                \"AIC\": aic,\n",
    "                \"Log-Lik\": ll,\n",
    "            })\n",
    "\n",
    "        except Exception as e:\n",
    "            failed_configs.append({\n",
    "                \"Embedding\": emb_t.upper(),\n",
    "                **params,\n",
    "                \"error\": str(e),\n",
    "            })\n",
    "\n",
    "    pbar.set_description(f\"✅ {emb_t.upper()} completado\")\n",
    "\n",
    "df_grid = pd.DataFrame(grid_results)\n",
    "df_failed = pd.DataFrame(failed_configs)\n",
    "\n",
    "print(f\"\\n✅ Configuraciones válidas: {len(df_grid)}\")\n",
    "print(f\"⚠️ Configuraciones fallidas: {len(df_failed)}\")\n",
    "\n",
    "if not df_failed.empty:\n",
    "    display(Markdown(\"###
    "    display(df_failed.head(10))\n",
    "\n",
    "
    "
    "
    "display(Markdown(f\"###
    "\n",
    "if not df_grid.empty:\n",
    "    df_sorted = (\n",
    "        df_grid\n",
    "        .sort_values(by=[\"Silueta\", \"BIC\"], ascending=[False, True])\n",
    "        .head(10)\n",
    "        .reset_index(drop=True)\n",
    "    )\n",
    "\n",
    "    df_show = df_sorted[[\n",
    "        \"Embedding\", \"Scaler\", \"Covarianza\", \"Init\", \"reg_covar\", \"max_iter\", \"tol\",\n",
    "        \"Silueta\", \"CH\", \"DB\", \"BIC\", \"AIC\", \"Log-Lik\"\n",
    "    ]].copy()\n",
    "\n",
    "    df_show.columns = pd.MultiIndex.from_tuples([\n",
    "        (\"Config\", \"Embedding\"),\n",
    "        (\"Config\", \"Scaler\"),\n",
    "        (\"Config\", \"Covarianza\"),\n",
    "        (\"Config\", \"Init\"),\n",
    "        (\"Config\", \"reg_covar\"),\n",
    "        (\"Config\", \"max_iter\"),\n",
    "        (\"Config\", \"tol\"),\n",
    "        (\"Silueta\", \"↑ MAX\"),\n",
    "        (\"Calinski-Harabasz\", \"↑ MAX\"),\n",
    "        (\"Davies-Bouldin\", \"↓ MIN\"),\n",
    "        (\"BIC\", \"↓ MIN\"),\n",
    "        (\"AIC\", \"↓ MIN\"),\n",
    "        (\"Log-Likelihood\", \"↑ MAX\"),\n",
    "    ])\n",
    "\n",
    "    styled = (\n",
    "        df_show.style\n",
    "        .background_gradient(subset=[(\"Silueta\", \"↑ MAX\")], cmap=\"Greens\")\n",
    "        .background_gradient(subset=[(\"Calinski-Harabasz\", \"↑ MAX\")], cmap=\"Greens\")\n",
    "        .background_gradient(subset=[(\"Davies-Bouldin\", \"↓ MIN\")], cmap=\"Reds_r\")\n",
    "        .background_gradient(subset=[(\"BIC\", \"↓ MIN\")], cmap=\"Reds_r\")\n",
    "        .background_gradient(subset=[(\"AIC\", \"↓ MIN\")], cmap=\"Reds_r\")\n",
    "        .background_gradient(subset=[(\"Log-Likelihood\", \"↑ MAX\")], cmap=\"Blues\")\n",
    "        .format({\n",
    "            (\"Silueta\", \"↑ MAX\"): \"{:.4f}\",\n",
    "            (\"Calinski-Harabasz\", \"↑ MAX\"): \"{:.1f}\",\n",
    "            (\"Davies-Bouldin\", \"↓ MIN\"): \"{:.4f}\",\n",
    "            (\"BIC\", \"↓ MIN\"): \"{:.1f}\",\n",
    "            (\"AIC\", \"↓ MIN\"): \"{:.1f}\",\n",
    "            (\"Log-Likelihood\", \"↑ MAX\"): \"{:.4f}\",\n",
    "        })\n",
    "        .set_table_styles([\n",
    "            {\n",
    "                \"selector\": \"th.col_heading.level0\",\n",
    "                \"props\": \"font-size: 12px; font-weight: bold; text-align: center; border-bottom: 2px solid #333;\"\n",
    "            },\n",
    "            {\n",
    "                \"selector\": \"th.col_heading.level1\",\n",
    "                \"props\": \"font-size: 10px; font-style: italic; color: #555; text-align: center;\"\n",
    "            },\n",
    "        ])\n",
    "    )\n",
    "    display(styled)\n",
    "\n",
    "    best = df_sorted.iloc[0]\n",
    "    display(Markdown(f\"\"\"\n",
    "###
    "- **Embedding**: {best[\"Embedding\"]}\n",
    "- **Scaler**: {best[\"Scaler\"]}\n",
    "- **Covarianza**: {best[\"Covarianza\"]}\n",
    "- **Init**: {best[\"Init\"]}\n",
    "- **reg_covar**: {best[\"reg_covar\"]}\n",
    "- **max_iter**: {best[\"max_iter\"]}\n",
    "- **tol**: {best[\"tol\"]}\n",
    "- **Silueta**: {best[\"Silueta\"]:.4f}\n",
    "- **Davies-Bouldin**: {best[\"DB\"]:.4f}\n",
    "- **BIC**: {best[\"BIC\"]:.1f}\n",
    "- **AIC**: {best[\"AIC\"]:.1f}\n",
    "- **Log-Likelihood**: {best[\"Log-Lik\"]:.4f}\n",
    "\"\"\"))\n",
    "else:\n",
    "    print(\"⚠️ No se generaron resultados válidos.\")"
   ]
  },
