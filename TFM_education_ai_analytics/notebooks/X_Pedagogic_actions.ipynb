   "source": [
    "def build_simple_prediction_table(seg_df: pd.DataFrame, pred_df: pd.DataFrame, split_name: str) -> pd.DataFrame:\n",
    "    seg_cols = [\"unique_id\", \"cluster_id\", \"cluster_name\"]\n",
    "    pred_cols = [\"unique_id\", \"pred_class_name\", \"true_class_name\"]\n",
    "\n",
    "    missing_seg = [col for col in seg_cols if col not in seg_df.columns]\n",
    "    missing_pred = [col for col in pred_cols if col not in pred_df.columns]\n",
    "\n",
    "    if missing_seg:\n",
    "        raise ValueError(f\"{split_name}: faltan columnas en segmentación: {missing_seg}\")\n",
    "    if missing_pred:\n",
    "        raise ValueError(f\"{split_name}: faltan columnas en predicción transformer: {missing_pred}\")\n",
    "\n",
    "    prob_cols = [col for col in pred_df.columns if col.startswith(\"prob_\")]\n",
    "    if not prob_cols:\n",
    "        raise ValueError(f\"{split_name}: no hay columnas de probabilidad en las predicciones transformer.\")\n",
    "\n",
    "    transformer_prob_col = None\n",
    "    preferred_prob_cols = [\n",
    "        \"prob_withdrawn\",\n",
    "        \"prob_fail_withdrawn\",\n",
    "        \"prob_fail\",\n",
    "        \"prob_risk\",\n",
    "    ]\n",
    "    for col in preferred_prob_cols:\n",
    "        if col in prob_cols:\n",
    "            transformer_prob_col = col\n",
    "            break\n",
    "\n",
    "    if transformer_prob_col is None:\n",
    "        transformer_prob_col = prob_cols[0]\n",
    "\n",
    "    table = (\n",
    "        pred_df[[\"unique_id\", \"pred_class_name\", transformer_prob_col, \"true_class_name\"]]\n",
    "        .merge(seg_df[seg_cols], on=\"unique_id\", how=\"left\")\n",
    "        .rename(\n",
    "            columns={\n",
    "                \"unique_id\": \"student_unique_id\",\n",
    "                \"cluster_id\": \"cluster_prediction_id\",\n",
    "                \"cluster_name\": \"cluster_prediction_label\",\n",
    "                \"pred_class_name\": \"transformer_prediction_label\",\n",
    "                transformer_prob_col: \"transformer_probability\",\n",
    "                \"true_class_name\": \"real_label\",\n",
    "            }\n",
    "        )\n",
    "    )\n",
    "\n",
    "    table.insert(0, \"split\", split_name)\n",
    "    return table[\n",
    "        [\n",
    "            \"split\",\n",
    "            \"student_unique_id\",\n",
    "            \"cluster_prediction_id\",\n",
    "            \"cluster_prediction_label\",\n",
    "            \"transformer_prediction_label\",\n",
    "            \"transformer_probability\",\n",
    "            \"real_label\",\n",
    "        ]\n",
    "    ].sort_values(\"student_unique_id\").reset_index(drop=True)\n",
    "\n",
    "\n",
    "simple_validation_table = build_simple_prediction_table(seg_validation, pred_validation, \"validation\")\n",
    "simple_test_table = build_simple_prediction_table(seg_test, pred_test, \"test\")\n",
    "\n",
    "simple_predictions_table = pd.concat(\n",
    "    [simple_validation_table, simple_test_table],\n",
    "    ignore_index=True,\n",
    ")\n",
    "\n",
    "display(simple_predictions_table.head(50))\n",
    "print(simple_predictions_table.shape)"
   ]
  },
