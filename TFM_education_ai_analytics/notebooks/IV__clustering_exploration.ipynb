    "MAX_POINTS_METRICS = 30000\n",
    "\n",
    "
    "
    "
    "COLORS_MAP = {3: \"#FFD700\", 2: \"#4A79B7\", 1: \"#C54443\", 0: \"#E39063\"}\n",
    "LABELS_MAP = {3: \"Distinction\", 2: \"Pass\", 1: \"Fail\", 0: \"Withdrawn\"}\n",
    "\n",
    "
    "
